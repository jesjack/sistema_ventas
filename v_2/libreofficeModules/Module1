Function TPV_DirectorioProyecto() As String
    ' Deriva la raiz del proyecto a partir de la ubicacion real del documento
    ' abierto (share/main.ods) en vez de hardcodear una ruta por maquina/SO:
    ' main.ods y libreofficeModules/ cuelgan del mismo directorio raiz, asi
    ' que basta con subir dos niveles (quitar "main.ods" y luego "share").
    Dim rutaDocumento As String
    Dim separador As Long

    TPV_DirectorioProyecto = ""

    On Error Resume Next
    rutaDocumento = ConvertFromURL(ThisComponent.getURL())
    On Error GoTo 0

    If rutaDocumento = "" Then
        Exit Function
    End If

    separador = TPV_UltimoSeparadorRuta(rutaDocumento)
    If separador = 0 Then
        Exit Function
    End If
    rutaDocumento = Left(rutaDocumento, separador - 1) ' quita "main.ods"

    separador = TPV_UltimoSeparadorRuta(rutaDocumento)
    If separador = 0 Then
        Exit Function
    End If
    rutaDocumento = Left(rutaDocumento, separador - 1) ' quita "share"

    TPV_DirectorioProyecto = rutaDocumento
End Function

Function TPV_RutaModule1(os As String) As String
    Dim raiz As String

    raiz = TPV_DirectorioProyecto()
    If raiz = "" Then
        Exit Function
    End If

    If os = 1 Then
        TPV_RutaModule1 = raiz & "\libreofficeModules\Module1"
    Else
        TPV_RutaModule1 = raiz & "/libreofficeModules/Module1"
    End If
End Function

Function TPV_VersionEnArchivo(rutaArchivo As String) As Long
    ' -1 significa "no se pudo verificar" (archivo ausente, sin acceso, o no
    ' se encontro la constante) -- nunca se interpreta como una version real,
    ' para no disparar una advertencia falsa cuando simplemente no se puede
    ' leer el archivo desde esta maquina.
    Dim archivo As Integer
    Dim linea As String
    Dim posicionConst As Long
    Dim posicionIgual As Long
    Dim resto As String
    Dim numeroError As Long

    TPV_VersionEnArchivo = -1

    If rutaArchivo = "" Then
        Exit Function
    End If

    If Dir(rutaArchivo) = "" Then
        Exit Function
    End If

    archivo = FreeFile

    ' Nota: no combinar Err.Number y Err.Description en la misma linea aqui --
    ' se probo y hacia que la funcion abortara sin avisar (ver historial de
    ' esta tarea). Leer Err.Number solo, en su propia linea, evita el problema.
    On Error Resume Next
    Open rutaArchivo For Input As #archivo
    numeroError = Err.Number
    On Error GoTo 0

    If numeroError <> 0 Then
        Exit Function
    End If

    Do While Not EOF(archivo)
        Line Input #archivo, linea
        posicionConst = InStr(linea, "TPV_MODULE_VERSION")
        If posicionConst > 0 And InStr(linea, "Const") > 0 Then
            posicionIgual = InStr(linea, "=")
            If posicionIgual > 0 Then
                resto = Trim(Mid(linea, posicionIgual + 1))
                If IsNumeric(resto) Then
                    TPV_VersionEnArchivo = CLng(resto)
                End If
            End If
            Exit Do
        End If
    Loop

    Close #archivo
End Function

Sub TPV_VerificarVersionModulo(os As String)
    Dim versionArchivo As Long

    versionArchivo = TPV_VersionEnArchivo(TPV_RutaModule1(os))

    If versionArchivo = -1 Then
        Exit Sub
    End If

    If versionArchivo <> TPV_MODULE_VERSION Then
        MsgBox "La macro cargada en este documento (version " & TPV_MODULE_VERSION & _
            ") no coincide con la version del archivo Module1 en el repositorio (version " & versionArchivo & ")." & _
            Chr(10) & Chr(10) & _
            "Copia el codigo actualizado al editor de macros (Herramientas > Macros > Editar macros) y guarda el documento.", _
            48, "Version de macro desactualizada"
    End If
End Sub

