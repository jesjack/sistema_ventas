%% chip: gestor
%% 2. SO y gestor de paquetes: instala uv (paso 1) y LibreOffice (lo pide sistema-ventas instalar).
flowchart TD
    iUv(("IN instalar_uv<br/>← Administrador")):::per
    G1{"¿Linux o Windows?"}
    G2["Corre el script oficial de uv"]
    oRep1(("OUT pedir_repositorio<br/>→ Internet")):::ext
    G3["winget busca astral-sh.uv"]
    oRep2(("OUT pedir_repositorio<br/>→ Internet")):::ext
    iRepUv(("IN repositorio_datos<br/>← Internet<br/>(uv)")):::ext
    G4["Instala uv"]
    oUvOk(("OUT uv_instalado<br/>→ Administrador")):::per
    iPaq(("IN instalar_paquete<br/>← App")):::app
    G5{"¿Linux o Windows?"}
    G6["apt install libreoffice-calc python3-uno"]
    oRep3(("OUT pedir_repositorio<br/>→ Internet")):::ext
    G7["winget install<br/>TheDocumentFoundation.LibreOffice"]
    oRep4(("OUT pedir_repositorio<br/>→ Internet")):::ext
    iRepLo(("IN repositorio_datos<br/>← Internet<br/>(LibreOffice)")):::ext
    G8["Instala los paquetes"]
    oPaqOk(("OUT paquete_instalado<br/>→ App")):::app

    iUv --> G1
    G1 -- "Linux" --> G2
    G2 --> oRep1
    G1 -- "Windows" --> G3
    G3 --> oRep2
    iRepUv --> G4
    G4 --> oUvOk
    iPaq --> G5
    G5 -- "Linux" --> G6
    G6 --> oRep3
    G5 -- "Windows" --> G7
    G7 --> oRep4
    iRepLo --> G8
    G8 --> oPaqOk

    classDef default fill:#e7e5e4,stroke:#57534e,color:#1c1917,stroke-width:2px
    classDef par fill:#57534e,stroke:#111827,color:#ffffff,stroke-width:2px
    classDef per fill:#e0f2fe,stroke:#0369a1,color:#082f49,stroke-width:2px
    classDef ges fill:#e7e5e4,stroke:#57534e,color:#1c1917,stroke-width:2px
    classDef uv fill:#fce7f3,stroke:#be185d,color:#500724,stroke-width:2px
    classDef app fill:#dcfce7,stroke:#15803d,color:#0b3d1c,stroke-width:2px
    classDef ext fill:#f3f4f6,stroke:#6b7280,color:#1f2937,stroke-width:1px,stroke-dasharray:4 3
