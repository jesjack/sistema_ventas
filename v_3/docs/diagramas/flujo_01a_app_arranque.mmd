%% chip: App
%% 1a. Arranque de App: candado del usuario, LibreOffice, base de datos y turno de caja.
flowchart TD
    iInicio(("IN inicio<br/>← SO")):::ext
    A1["Abre el log de esta ejecución;<br/>arranca el hilo del log y el vigilante (1o)"]
    LA[("log_actual en la carpeta de ejecución: escribe<br/>la ruta del log de esta ejecución (D20)")]
    K1[("Candado del usuario:<br/>intenta tomarlo (D8)")]
    D1{"¿Lo obtuvo?"}
    A2["Arma el aviso:<br/>el sistema ya está abierto"]
    oQt1(("OUT ventana_qt<br/>→ Usuario")):::ext
    iR1(("IN respuesta_usuario<br/>← Usuario<br/>(aviso: ya abierto)")):::ext
    T2(["Fin de App"])
    A3["Busca LibreOffice y su Python:<br/>PATH o registro (D9)"]
    D2{"¿Los encontró?"}
    A4["Arma el aviso:<br/>falta LibreOffice"]
    oQt2(("OUT ventana_qt<br/>→ Usuario")):::ext
    iR2(("IN respuesta_usuario<br/>← Usuario<br/>(aviso: falta LibreOffice)")):::ext
    T3(["Fin de App"])
    DB0[("ventas.db: aplica las<br/>migraciones pendientes (D16)")]
    DB1[("ventas.db:<br/>registra usuario y sesión")]
    D4{"¿Se registró?"}
    A8["Arma el aviso:<br/>sin botones personalizados"]
    oQt3(("OUT ventana_qt<br/>→ Usuario")):::ext
    iR3(("IN respuesta_usuario<br/>← Usuario<br/>(aviso: sin botones)")):::ext
    A9["Arma la toma del turno de caja"]
    DB2[("ventas.db: en una transacción, turno + 1<br/>y la sesión anterior queda «desplazada»<br/>por este usuario (D8)")]
    A7["Guarda su número de turno (RAM)"]
    DBc[("ventas.db: lee si hay código de<br/>apertura de caja configurado (D20)")]
    Dc{"¿Hay código configurado?"}
    Dadm{"¿El usuario es el administrador?"}
    S1[["Configurar código de caja (1p)"]]
    A11["Arma el aviso: la caja con código queda bloqueada<br/>hasta que el administrador configure el código"]
    oQt4(("OUT ventana_qt<br/>→ Usuario")):::ext
    iR4(("IN respuesta_usuario<br/>← Usuario<br/>(aviso: sin código de caja)")):::ext
    A10["modo = normal;<br/>contador de caídas = 0 (RAM)"]
    S2[["Abrir LibreOffice (1b)"]]
    T4(["Queda atendiendo eventos (1d)"])

    iInicio --> A1
    A1 --> LA
    LA --> K1
    K1 --> D1
    D1 -- "No" --> A2
    A2 --> oQt1
    iR1 --> T2
    D1 -- "Sí" --> A3
    A3 --> D2
    D2 -- "No" --> A4
    A4 --> oQt2
    iR2 --> T3
    D2 -- "Sí" --> DB0
    DB0 --> DB1
    DB1 --> D4
    D4 -- "No" --> A8
    A8 --> oQt3
    iR3 --> A9
    D4 -- "Sí" --> A9
    A9 --> DB2
    DB2 --> A7
    A7 --> DBc
    DBc --> Dc
    Dc -- "Sí" --> A10
    Dc -- "No" --> Dadm
    Dadm -- "Sí" --> S1
    S1 --> A10
    Dadm -- "No" --> A11
    A11 --> oQt4
    iR4 --> A10
    A10 --> S2
    S2 --> T4

    classDef default fill:#dcfce7,stroke:#15803d,color:#0b3d1c,stroke-width:2px
    classDef par fill:#15803d,stroke:#111827,color:#ffffff,stroke-width:2px
    classDef app fill:#dcfce7,stroke:#15803d,color:#0b3d1c,stroke-width:2px
    classDef sof fill:#dbeafe,stroke:#1d4ed8,color:#0b1f4d,stroke-width:2px
    classDef bas fill:#fef9c3,stroke:#a16207,color:#422006,stroke-width:2px
    classDef uno fill:#ccfbf1,stroke:#0f766e,color:#042f2e,stroke-width:2px
    classDef cam fill:#ffedd5,stroke:#c2410c,color:#431407,stroke-width:2px
    classDef ext fill:#f3f4f6,stroke:#6b7280,color:#1f2937,stroke-width:1px,stroke-dasharray:4 3
