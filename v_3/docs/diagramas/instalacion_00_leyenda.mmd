%% leyenda
%% Actores de la instalación (D16). Los pines OUT llevan el color del destino y los IN el del origen;
%% cada cilindro lleva el color del actor que consigue esos datos.
flowchart LR
    L1["Administrador (persona)"]:::per
    L2["SO y gestor de paquetes<br/>(apt, winget, script de uv)"]:::ges
    L3["uv"]:::uv
    L4["App: sistema-ventas instalar<br/>y primer arranque"]:::app
    L5["Internet o usuario<br/>(no es un actor del flujo)"]:::ext
    L6["═══ en paralelo ═══"]:::par
    classDef par fill:#374151,stroke:#111827,color:#ffffff,stroke-width:2px

    classDef per fill:#e0f2fe,stroke:#0369a1,color:#082f49,stroke-width:2px
    classDef ges fill:#e7e5e4,stroke:#57534e,color:#1c1917,stroke-width:2px
    classDef uv fill:#fce7f3,stroke:#be185d,color:#500724,stroke-width:2px
    classDef app fill:#dcfce7,stroke:#15803d,color:#0b3d1c,stroke-width:2px
    classDef ext fill:#f3f4f6,stroke:#6b7280,color:#1f2937,stroke-width:1px,stroke-dasharray:4 3
