%% chip: Administrador
%% 5. Actualización, como administrador: la misma instalación con otra etiqueta (o upgrade); las migraciones corren al arrancar App (D16, D20).
flowchart TD
    T0(["Actualizar el sistema"])
    U1["Pide a los usuarios cerrar el sistema<br/>(obligatorio en Windows, D20)"]
    U2["Arma, como administrador y con las mismas variables de uv,<br/>uv tool install con la etiqueta nueva (o uv tool upgrade)"]
    oUp(("OUT uv_tool_upgrade<br/>→ uv")):::uv
    iUvT(("IN uv_termino<br/>← uv<br/>(actualización)")):::uv
    D1{"¿Se actualizó?"}
    U3["Revisa el mensaje de error"]
    T9(["Fin con error"])
    T1(["Listo: las migraciones de ventas.db<br/>corren en el siguiente arranque de App"])

    T0 --> U1
    U1 --> U2
    U2 --> oUp
    iUvT --> D1
    D1 -- "No" --> U3
    U3 --> T9
    D1 -- "Sí" --> T1

    classDef default fill:#e0f2fe,stroke:#0369a1,color:#082f49,stroke-width:2px
    classDef par fill:#0369a1,stroke:#111827,color:#ffffff,stroke-width:2px
    classDef per fill:#e0f2fe,stroke:#0369a1,color:#082f49,stroke-width:2px
    classDef ges fill:#e7e5e4,stroke:#57534e,color:#1c1917,stroke-width:2px
    classDef uv fill:#fce7f3,stroke:#be185d,color:#500724,stroke-width:2px
    classDef app fill:#dcfce7,stroke:#15803d,color:#0b3d1c,stroke-width:2px
    classDef ext fill:#f3f4f6,stroke:#6b7280,color:#1f2937,stroke-width:1px,stroke-dasharray:4 3
