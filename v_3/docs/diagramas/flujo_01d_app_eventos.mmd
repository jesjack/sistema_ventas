%% chip: App
%% 1d. Eventos mientras App está viva (D22): cada camino empieza en un IN o en un temporizador.
flowchart TD
    TW(["Espera el siguiente evento"])
    iEnter(("IN enter_pulsado<br/>← UNO")):::uno
    S1[["Atender Enter (1e)"]]
    iTab(("IN tab_pulsado<br/>← UNO")):::uno
    D1{"¿B4 está vacía? (D14)"}
    DB1[("ventas.db: busca el<br/>texto en el catálogo")]
    D2{"¿Hay coincidencias?"}
    E2["Arma el selector Qt<br/>con las coincidencias"]
    oQt1(("OUT ventana_qt<br/>→ Usuario")):::ext
    iR1(("IN respuesta_usuario<br/>← Usuario<br/>(selector de Tab)")):::ext
    D3{"¿Eligió un producto?"}
    E3["Arma el producto para B4 y el foco<br/>sin mover el cursor (queda en PRECIO)"]
    PAR1["═══ en paralelo ═══"]:::par
    oEsc(("OUT escribir_producto<br/>→ UNO")):::uno
    oEnf1(("OUT enfocar_calc<br/>→ UNO")):::uno
    E4["Arma el foco sin mover el cursor"]
    oEnf2(("OUT enfocar_calc<br/>→ UNO")):::uno
    iBoton(("IN boton_pulsado<br/>← UNO")):::uno
    S2[["Atender botón (1g)"]]
    Tturno(["Cada ~3 s (D8, D20)"])
    Dpos{"¿El POS está abierto?"}
    S5[["Comprobar turno (1l)"]]
    iDoc(("IN documento_cerrado<br/>← UNO")):::uno
    E6["Anota el motivo:<br/>cierre normal o caída"]
    iUnoSalio(("IN uno_salio<br/>← UNO<br/>(con el sistema andando)")):::uno
    D4{"¿soffice sigue vivo?"}
    S3[["Conectar UNO (1c)"]]
    iSofSalio(("IN soffice_salio<br/>← soffice")):::sof
    S4[["Tras salir soffice (1j)"]]
    iReabrir(("IN reabrir_libreoffice<br/>← App nueva del mismo usuario")):::app
    Dr{"¿soffice está abierto?"}
    E10["Arma el foco: trae Calc al frente"]
    oEnf3(("OUT enfocar_calc<br/>→ UNO")):::uno
    E11["Arma la toma del turno de caja (D8)"]
    DB4[("ventas.db: en una transacción, turno + 1<br/>y la sesión anterior queda «desplazada»")]
    E12["Guarda su número de turno (RAM)"]
    S6[["Abrir LibreOffice (1b)"]]
    iCamL(("IN camaras_lista<br/>← camera_viewer")):::cam
    E13["camaras_abierto = sí (RAM)"]
    DB5[("ventas.db: lee las<br/>ventas del día")]
    E14["Arma las ventas del día"]
    oVentas(("OUT ventas_del_dia<br/>→ camera_viewer")):::cam
    iCamS(("IN camaras_salio<br/>← camera_viewer")):::cam
    E9["camaras_abierto = no;<br/>registra la salida"]
    D5{"¿soffice sigue abierto?"}
    S7[["Cierre de App (1k)"]]
    TF(["Fin de App: no queda nada abierto (D22)"])
    Tsen(["Llega la señal de un hilo de trabajo (D18)"])
    S8[["Resultado de un hilo de trabajo (1n)"]]

    iEnter --> S1
    S1 --> TW
    iTab --> D1
    D1 -- "Sí" --> TW
    D1 -- "No" --> DB1
    DB1 --> D2
    D2 -- "No" --> TW
    D2 -- "Sí" --> E2
    E2 --> oQt1
    iR1 --> D3
    D3 -- "Sí" --> E3
    E3 --> PAR1
    PAR1 --> oEsc
    PAR1 --> oEnf1
    D3 -- "No" --> E4
    E4 --> oEnf2
    iBoton --> S2
    S2 --> TW
    Tturno --> Dpos
    Dpos -- "Sí" --> S5
    Dpos -- "No" --> TW
    S5 --> TW
    iDoc --> E6
    E6 --> TW
    iUnoSalio --> D4
    D4 -- "Sí: relanza solo UNO" --> S3
    S3 --> TW
    D4 -- "No" --> TW
    iSofSalio --> S4
    S4 --> TW
    iReabrir --> Dr
    Dr -- "Sí" --> E10
    E10 --> oEnf3
    Dr -- "No" --> E11
    E11 --> DB4
    DB4 --> E12
    E12 --> S6
    S6 --> TW
    iCamL --> E13
    E13 --> DB5
    DB5 --> E14
    E14 --> oVentas
    iCamS --> E9
    E9 --> D5
    D5 -- "Sí" --> TW
    D5 -- "No" --> S7
    S7 --> TF
    Tsen --> S8
    S8 --> TW

    classDef default fill:#dcfce7,stroke:#15803d,color:#0b3d1c,stroke-width:2px
    classDef par fill:#15803d,stroke:#111827,color:#ffffff,stroke-width:2px
    classDef app fill:#dcfce7,stroke:#15803d,color:#0b3d1c,stroke-width:2px
    classDef sof fill:#dbeafe,stroke:#1d4ed8,color:#0b1f4d,stroke-width:2px
    classDef bas fill:#fef9c3,stroke:#a16207,color:#422006,stroke-width:2px
    classDef uno fill:#ccfbf1,stroke:#0f766e,color:#042f2e,stroke-width:2px
    classDef cam fill:#ffedd5,stroke:#c2410c,color:#431407,stroke-width:2px
    classDef ext fill:#f3f4f6,stroke:#6b7280,color:#1f2937,stroke-width:1px,stroke-dasharray:4 3
