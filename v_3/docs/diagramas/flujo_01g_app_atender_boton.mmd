%% chip: App
%% 1g. Atender un botón de la hoja (el clic llega por Basic → .evt → UNO, D3).
flowchart TD
    T0(["Atender botón"])
    D0{"¿Qué botón?"}
    S1[["Abrir cámaras (1i)"]]
    T1(["Regresa sin enfocar Calc"])
    S2[["Menú de administración (1h)"]]
    T2(["Regresa"])
    F1["Arma el diálogo de fecha"]
    oQt1(("OUT ventana_qt<br/>→ Usuario")):::ext
    iR1(("IN respuesta_usuario<br/>← Usuario<br/>(fecha)")):::ext
    D1{"¿Eligió una fecha?"}
    F1b["Vuelve a Calc"]
    oEnfA(("OUT enfocar_calc<br/>→ UNO")):::uno
    F2["modo = ventas_dia con la fecha;<br/>relanzar = sí"]
    oCerrar1(("OUT cerrar_libreoffice<br/>→ UNO")):::uno
    F3["modo = normal; relanzar = sí"]
    oCerrar2(("OUT cerrar_libreoffice<br/>→ UNO")):::uno
    S3[["Abrir caja y registrar (1m)"]]
    F4["Vacía el carrito;<br/>arma la tabla vacía"]
    PAR1["═══ en paralelo ═══"]:::par
    oPin(("OUT pintar<br/>→ UNO")):::uno
    oEnfC(("OUT enfocar_calc<br/>→ UNO")):::uno
    F5["Arma el diálogo con<br/>vista previa de la etiqueta"]
    oQt2(("OUT ventana_qt<br/>→ Usuario")):::ext
    iR2(("IN respuesta_usuario<br/>← Usuario<br/>(vista previa)")):::ext
    D2{"¿Confirmó la impresión?"}
    F5b["Vuelve a Calc"]
    oEnfD(("OUT enfocar_calc<br/>→ UNO")):::uno
    S4[["Comprobar turno (1l)"]]
    F6["Arma la etiqueta"]
    PAR2["═══ en paralelo ═══"]:::par
    S5[["Hilo de trabajo: etiqueta (1n)"]]
    Tfin(["El resultado llega por señal (1d)"])
    F6b["Vuelve a Calc"]
    oEnfE(("OUT enfocar_calc<br/>→ UNO")):::uno
    DB1[("ventas.db:<br/>lee los códigos")]
    F9["Arma la ventana con la lista"]
    oQt4(("OUT ventana_qt<br/>→ Usuario")):::ext
    DB2[("ventas.db:<br/>lee el catálogo")]
    F11["Arma el editor del catálogo"]
    oQt5(("OUT ventana_qt<br/>→ Usuario")):::ext
    iR4(("IN respuesta_usuario<br/>← Usuario<br/>(editor del catálogo)")):::ext
    D3{"¿Guardó cambios?"}
    F11b["Vuelve a Calc"]
    oEnfF(("OUT enfocar_calc<br/>→ UNO")):::uno
    S6[["Comprobar turno (1l)"]]
    DB3[("ventas.db:<br/>guarda el catálogo")]
    F12["Vuelve a Calc"]
    oEnfG(("OUT enfocar_calc<br/>→ UNO")):::uno
    F13["Lo registra en el log de App"]
    oEnfH(("OUT enfocar_calc<br/>→ UNO")):::uno

    T0 --> D0
    D0 -- "VER CÁMARAS" --> S1
    S1 --> T1
    D0 -- "ADMINISTRAR (solo el administrador)" --> S2
    S2 --> T2
    D0 -- "VER VENTAS" --> F1
    F1 --> oQt1
    iR1 --> D1
    D1 -- "No" --> F1b
    F1b --> oEnfA
    D1 -- "Sí" --> F2
    F2 --> oCerrar1
    D0 -- "REGRESAR AL SISTEMA PRINCIPAL" --> F3
    F3 --> oCerrar2
    D0 -- "ABRIR CAJA" --> S3
    S3 --> T2
    D0 -- "LIMPIAR CARRITO" --> F4
    F4 --> PAR1
    PAR1 --> oPin
    PAR1 --> oEnfC
    D0 -- "IMPRIMIR CÓDIGO" --> F5
    F5 --> oQt2
    iR2 --> D2
    D2 -- "No" --> F5b
    F5b --> oEnfD
    D2 -- "Sí" --> S4
    S4 --> F6
    F6 --> PAR2
    PAR2 --> S5
    S5 --> Tfin
    PAR2 --> F6b
    F6b --> oEnfE
    D0 -- "VER CÓDIGOS" --> DB1
    DB1 --> F9
    F9 --> oQt4
    D0 -- "CATÁLOGO" --> DB2
    DB2 --> F11
    F11 --> oQt5
    iR4 --> D3
    D3 -- "No" --> F11b
    F11b --> oEnfF
    D3 -- "Sí" --> S6
    S6 --> DB3
    DB3 --> F12
    F12 --> oEnfG
    D0 -- "otro: ping o id desconocido" --> F13
    F13 --> oEnfH

    classDef default fill:#dcfce7,stroke:#15803d,color:#0b3d1c,stroke-width:2px
