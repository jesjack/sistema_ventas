%% chip: camera_viewer
%% 4. camera_viewer: hijo de App (D22), caja negra por dentro, conectado por multiprocessing.connection. El orden interno es ilustrativo.
flowchart TD
    iArr(("IN arrancar_camaras<br/>← App")):::app
    U1["Se conecta al canal de App<br/>con la clave (D22)"]
    PAR0["═══ en paralelo ═══"]:::par
    oLista(("OUT camaras_lista<br/>→ App")):::app
    M1[["Visor<br/>(caja negra, otra instancia)"]]
    PAR1["═══ en paralelo ═══"]:::par
    oLog(("OUT log_camaras<br/>→ App")):::app
    oVen(("OUT ventana_camaras<br/>→ Usuario")):::ext
    oDvrP(("OUT dvr_camaras_pedir<br/>→ DVR")):::ext
    iDvrD(("IN dvr_camaras_datos<br/>← DVR")):::ext
    iVentas(("IN ventas_del_dia<br/>← App")):::app
    M3["Marca las ventas en su<br/>línea de tiempo (D11)"]
    iFecha(("IN abrir_en_fecha_hora<br/>← App")):::app
    M2["Salta a esa fecha y hora"]
    iMostrar(("IN mostrar_camaras<br/>← App")):::app
    M4["Se pone al frente"]
    iVN(("IN venta_nueva<br/>← App")):::app
    M6["Marca la venta nueva al instante (D23)"]
    iCerrar(("IN cerrar_camaras<br/>← App")):::app
    M5["Cierra el visor (App desplazada, D23)"]
    oSal2(("OUT camaras_salio<br/>→ App")):::app
    iResp(("IN respuesta_camaras<br/>← Usuario")):::ext
    D1{"¿Cerró la ventana?"}
    oSal(("OUT camaras_salio<br/>→ App")):::app

    iArr --> U1
    U1 --> PAR0
    PAR0 --> oLista
    PAR0 --> M1
    M1 --> PAR1
    PAR1 --> oLog
    PAR1 --> oVen
    PAR1 --> oDvrP
    iDvrD --> M1
    iVentas --> M3
    M3 --> M1
    iFecha --> M2
    M2 --> M1
    iMostrar --> M4
    M4 --> M1
    iVN --> M6
    M6 --> M1
    iCerrar --> M5
    M5 --> oSal2
    iResp --> D1
    D1 -- "No" --> M1
    D1 -- "Sí" --> oSal

    classDef default fill:#ffedd5,stroke:#c2410c,color:#431407,stroke-width:2px
    classDef par fill:#c2410c,stroke:#111827,color:#ffffff,stroke-width:2px
    classDef app fill:#dcfce7,stroke:#15803d,color:#0b3d1c,stroke-width:2px
    classDef sof fill:#dbeafe,stroke:#1d4ed8,color:#0b1f4d,stroke-width:2px
    classDef bas fill:#fef9c3,stroke:#a16207,color:#422006,stroke-width:2px
    classDef uno fill:#ccfbf1,stroke:#0f766e,color:#042f2e,stroke-width:2px
    classDef cam fill:#ffedd5,stroke:#c2410c,color:#431407,stroke-width:2px
    classDef ext fill:#f3f4f6,stroke:#6b7280,color:#1f2937,stroke-width:1px,stroke-dasharray:4 3
