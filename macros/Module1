' -----------------------------------------------------------------------------
' 6. AGREGAR PRODUCTO
' -----------------------------------------------------------------------------
Sub AgregarProducto

    ' Confirmar cualquier edición activa antes de leer los valores
    Dim oFrame As Object
    Dim oDispatcher As Object
    Dim codigoBuscado As String
    Dim nombreEncontrado As String
    Dim precioEncontrado As Double
    Dim encontrado As Boolean
    oFrame      = ThisComponent.CurrentController.Frame
    oDispatcher = createUnoService("com.sun.star.frame.DispatchHelper")
    oDispatcher.executeDispatch(oFrame, ".uno:AcceptFormula", "", 0, Array())

    Dim oDoc As Object
    Dim oSheet As Object

    oDoc   = ThisComponent
    oSheet = oDoc.Sheets.getByName("TPV")

    Dim prod As String
    Dim precio As Double
    Dim cant As Integer
    Dim rawEntrada As String

    rawEntrada = Trim(ObtenerTextoEntradaTPV(oSheet))
    prod   = CapitalizarTexto(rawEntrada)
    precio = CDbl(SoloNumeros(CStr(oSheet.getCellRangeByName("C3").String)))
    cant   = CInt(Int(CDbl(SoloNumeros(CStr(oSheet.getCellRangeByName("D3").String)))))

    If UCase(Left(Trim(prod), 2)) = "C " Then
        codigoBuscado = Trim(Mid(Trim(prod), 3))
        Call BuscarProductoPorCodigoEnTXT(ObtenerRutaCarpeta() & "catalogo.txt", codigoBuscado, nombreEncontrado, precioEncontrado, encontrado)

        If Not encontrado Then
            MsgBox "Producto no encontrado para el código: " & codigoBuscado, 48, "TPV"
            Exit Sub
        End If

        prod = nombreEncontrado
        precio = precioEncontrado

        If precio <= 0 Then
            oSheet.unprotect("")
            oSheet.getCellRangeByName("B3").String = prod
            oSheet.getCellRangeByName("C3").clearContents(1023)
            oSheet.getCellRangeByName("D3").Value = 1
            oSheet.protect("")
            IrAC3
            Exit Sub
        End If
    End If

    ' Si no fue un comando C, intentar buscar un código reservado directo en catalogo.txt
    If Not (UCase(Left(Trim(rawEntrada), 2)) = "C ") Then
        codigoBuscado = Trim(rawEntrada)
        Call BuscarCodigoReservadoEnTXT(ObtenerRutaCarpeta() & "catalogo.txt", codigoBuscado, nombreEncontrado, precioEncontrado, encontrado)

        If encontrado Then
            prod = nombreEncontrado
            precio = precioEncontrado

            If precio <= 0 Then
                oSheet.unprotect("")
                oSheet.getCellRangeByName("B3").String = prod
                oSheet.getCellRangeByName("C3").clearContents(1023)
                oSheet.getCellRangeByName("D3").Value = 1
                oSheet.protect("")
                IrAC3
                Exit Sub
            End If
        End If
    End If

    If prod = "" Then
        FinalizarVentaEImprimir
        Exit Sub
    End If

    If cant <= 0 Then cant = 1

    oSheet.unprotect("")

    ' ── Encontrar dónde está el TOTAL actualmente ──
    Dim filaTotal As Integer
    filaTotal = ObtenerFilaTotal(oSheet)

    ' ── Si el producto ya existe, solo aumentar la cantidad ──
    Dim filaExistente As Integer
    filaExistente = BuscarFilaProductoEnCarrito(oSheet, prod, precio)

    If filaExistente >= FILA_PRODUCTOS_INICIO And filaExistente < filaTotal Then
        Dim cantidadActual As Double
        cantidadActual = oSheet.getCellByPosition(3, filaExistente).Value

        oSheet.getCellByPosition(3, filaExistente).Value = cantidadActual + cant
        oSheet.getCellByPosition(4, filaExistente).Formula = _
            "=C" & (filaExistente + 1) & "*D" & (filaExistente + 1)

        AplicarEstiloFilaProducto oSheet, filaExistente

        ' Recolocar el TOTAL donde corresponde
        LimpiarFilaTotal(oSheet, filaTotal)
        ColocarFilaTotal(oSheet, filaTotal)

        oSheet.getCellRangeByName("B3:C3").clearContents(7)
        oSheet.getCellRangeByName("D3").Value = 1

        oSheet.protect("")

        GuardarArchivo
        IrAB3
        Exit Sub
    End If

    ' ── Limpiar el TOTAL de donde está ──
    LimpiarFilaTotal(oSheet, filaTotal)

    ' ── Escribir el producto en esa fila ──
    oSheet.getCellByPosition(1, filaTotal).String  = prod
    oSheet.getCellByPosition(2, filaTotal).Value   = precio
    oSheet.getCellByPosition(3, filaTotal).Value   = cant
    oSheet.getCellByPosition(4, filaTotal).Formula = _
        "=C" & (filaTotal+1) & "*D" & (filaTotal+1)

    AplicarEstiloFilaProducto oSheet, filaTotal

    ' ── Colocar el TOTAL en la siguiente fila ──
    ColocarFilaTotal(oSheet, filaTotal + 1)

    ' ── Limpiar input ──
    oSheet.getCellRangeByName("B3:C3").clearContents(7)
    oSheet.getCellRangeByName("D3").Value = 1

    oSheet.protect("")

    GuardarArchivo

    IrAB3

End Sub

Function ObtenerTextoEntradaTPV(oSheet As Object) As String

    Dim textoB3 As String
    Dim textoC3 As String
    Dim textoD3 As String

    textoB3 = Trim(oSheet.getCellRangeByName("B3").String)
    textoC3 = Trim(oSheet.getCellRangeByName("C3").String)
    textoD3 = Trim(oSheet.getCellRangeByName("D3").String)

    If LCase(textoB3) = "cobrar" Or LCase(textoB3) = "limpiar" Or LCase(Left(textoB3, 2)) = "c " Then
        ObtenerTextoEntradaTPV = textoB3
        Exit Function
    End If

    If LCase(textoC3) = "cobrar" Or LCase(textoC3) = "limpiar" Or LCase(Left(textoC3, 2)) = "c " Then
        ObtenerTextoEntradaTPV = textoC3
        Exit Function
    End If

    If LCase(textoD3) = "cobrar" Or LCase(textoD3) = "limpiar" Or LCase(Left(textoD3, 2)) = "c " Then
        ObtenerTextoEntradaTPV = textoD3
        Exit Function
    End If

    If textoC3 <> "" And Not EsNumeroTexto(textoC3) Then
        ObtenerTextoEntradaTPV = textoC3
        Exit Function
    End If

    If textoB3 <> "" Then
        ObtenerTextoEntradaTPV = textoB3
        Exit Function
    End If

    If textoC3 <> "" Then
        ObtenerTextoEntradaTPV = textoC3
        Exit Function
    End If

    ' Si no hay texto en B3 ni en C3 y D3 es numérico (valor por defecto),
    ' devolver cadena vacía para que Enter sin entrada active el cobro.
    If textoB3 = "" And textoC3 = "" Then
        If EsNumeroTexto(textoD3) Then
            ObtenerTextoEntradaTPV = ""
            Exit Function
        End If
    End If

    ObtenerTextoEntradaTPV = textoD3

End Function

Function BuscarFilaProductoEnCarrito(oSheet As Object, prod As String, precio As Double) As Integer

    Dim filaTotal As Integer
    Dim i As Integer
    Dim nombreFila As String
    Dim precioFila As Double

    filaTotal = ObtenerFilaTotal(oSheet)

    For i = FILA_PRODUCTOS_INICIO To filaTotal - 1
        nombreFila = Trim(oSheet.getCellByPosition(1, i).String)
        precioFila = oSheet.getCellByPosition(2, i).Value

        If LCase(nombreFila) = LCase(Trim(prod)) Then
            If Abs(precioFila - precio) < 0.0001 Or precio = 0 Then
                BuscarFilaProductoEnCarrito = i
                Exit Function
            End If
        End If
    Next i

    BuscarFilaProductoEnCarrito = -1

End Function

