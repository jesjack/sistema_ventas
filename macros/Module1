' -----------------------------------------------------------------------------
Sub CrearBoton( _
    oSheet As Object, _
    x As Long, y As Long, _
    ancho As Long, alto As Long, _
    label As String, _
    macroName As String _
)
    Dim oControlShape As Object
    Dim oControlModel As Object

    Dim aPos  As New com.sun.star.awt.Point
    Dim aSize As New com.sun.star.awt.Size

    aPos.X  = x      : aPos.Y  = y
    aSize.Width = ancho : aSize.Height = alto

    oControlShape = ThisComponent.createInstance("com.sun.star.drawing.ControlShape")
    oControlModel = ThisComponent.createInstance("com.sun.star.form.component.CommandButton")

    oControlShape.setControl(oControlModel)
    oSheet.DrawPage.add(oControlShape)
    oControlShape.setPosition(aPos)
    oControlShape.setSize(aSize)

    oControlShape.getControl().Label = label

    Dim sMacroURL As String
    sMacroURL = "vnd.sun.star.script:Standard.Module1." & macroName & "?language=Basic&location=document"

    Dim aEvent As New com.sun.star.script.ScriptEventDescriptor
    aEvent.ListenerType  = "XActionListener"
    aEvent.EventMethod   = "actionPerformed"
    aEvent.ScriptType    = "Script"
    aEvent.ScriptCode    = sMacroURL

    oSheet.DrawPage.Forms.getByIndex(0).registerScriptEvent( _
        oSheet.DrawPage.Forms.getByIndex(0).Count - 1, _
        aEvent _
    )

End Sub

