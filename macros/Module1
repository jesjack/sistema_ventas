' -----------------------------------------------------------------------------
' NUEVA RUTINA: Conecta LibreOffice Basic con tu script de Python
' -----------------------------------------------------------------------------
Sub LanzarPythonExterno(oSheet As Object)
    On Error Resume Next
    Dim resultado As Long
    Dim rutaScript As String

    ' Comando limpio para ejecutar tu script externo de Python en segundo plano
    rutaScript = ObtenerRutaCarpeta() & "script.py"

    ' Ejecutar de forma asíncrona (False) para que Calc no se congele
    resultado = Shell( "/usr/bin/python3", 0, Chr(34) & rutaScript & Chr(34) & " loop", False )
End Sub

' -----------------------------------------------------------------------------
' HELPER: Devuelve la ruta de la carpeta donde vive el .ods
' -----------------------------------------------------------------------------
Function ObtenerRutaCarpeta() As String
    Dim sURL As String
    sURL = ThisComponent.getURL()           ' file:///home/user/TPV/tpv.ods
    ' Convertir de URL a ruta del sistema operativo
    Dim sPath As String
    sPath = ConvertFromURL(sURL)            ' /home/user/TPV/tpv.ods
    ' Quitar el nombre del archivo — quedarse con la carpeta
    Dim pos As Integer
    pos = 0
    Dim i As Integer
    For i = Len(sPath) To 1 Step -1
        If Mid(sPath, i, 1) = "/" Then
            pos = i
            Exit For
        End If
    Next i
    ObtenerRutaCarpeta = Left(sPath, pos)   ' /home/user/TPV/
End Function

' -----------------------------------------------------------------------------
' HELPER: Registra una venta completa en SQLite invocando db_ventas.py
' Estrategia: escribe el JSON a /tmp/tpv_venta.json y Python lo lee desde ahí,
' eliminando por completo el problema de escapado de comillas en Shell.
' -----------------------------------------------------------------------------
Sub RegistrarVentaEnSQLite( _
    oSheetTPV As Object, _
    filaTotal As Integer, _
    totalTicket As Double, _
    montoCliente As Double, _
    cambio As Double, _
    tActual As Date _
)
    On Error GoTo ErrorSQL

    ' ── 1. Rutas ──
    Dim carpeta As String
    carpeta = ObtenerRutaCarpeta()

    Dim rutaScript As String
    rutaScript = carpeta & "db_ventas.py"

    Dim rutaDB As String
    rutaDB = carpeta & "ventas.db"

    Dim rutaJSON As String
    rutaJSON = "/tmp/tpv_venta.json"

    ' ── 2. Construir JSON ──
    Dim sFecha As String
    Dim sHora  As String
    sFecha = Format(tActual, "YYYY-MM-DD")
    sHora  = Format(tActual, "HH:MM:SS")

    Dim sItems As String
    sItems = "["
    Dim i As Integer
    Dim primero As Boolean
    primero = True

    For i = FILA_PRODUCTOS_INICIO To filaTotal - 1
        Dim prod As String
        prod = oSheetTPV.getCellByPosition(1, i).String
        If prod <> "" Then
            Dim precio   As Double
            Dim cantidad As Integer
            Dim subtotal As Double
            precio   = oSheetTPV.getCellByPosition(2, i).Value
            cantidad = CInt(oSheetTPV.getCellByPosition(3, i).Value)
            subtotal = oSheetTPV.getCellByPosition(4, i).Value

            ' Escapar comillas dobles dentro del nombre
            Dim prodEsc As String
            prodEsc = Join(Split(prod, Chr(34)), "\" & Chr(34))

            If Not primero Then sItems = sItems & ","
            sItems = sItems & "{" & _
                Chr(34) & "producto" & Chr(34) & ":" & Chr(34) & prodEsc & Chr(34) & "," & _
                Chr(34) & "precio"   & Chr(34) & ":" & Format(precio,   "0.00") & "," & _
                Chr(34) & "cantidad" & Chr(34) & ":" & cantidad & "," & _
                Chr(34) & "subtotal" & Chr(34) & ":" & Format(subtotal, "0.00") & _
            "}"
            primero = False
        End If
    Next i
    sItems = sItems & "]"

    Dim sJSON As String
    sJSON = "{" & _
        Chr(34) & "db_path"  & Chr(34) & ":" & Chr(34) & rutaDB       & Chr(34) & "," & _
        Chr(34) & "fecha"    & Chr(34) & ":" & Chr(34) & sFecha        & Chr(34) & "," & _
        Chr(34) & "hora"     & Chr(34) & ":" & Chr(34) & sHora         & Chr(34) & "," & _
        Chr(34) & "total"    & Chr(34) & ":" & Format(totalTicket,  "0.00") & "," & _
        Chr(34) & "recibido" & Chr(34) & ":" & Format(montoCliente, "0.00") & "," & _
        Chr(34) & "cambio"   & Chr(34) & ":" & Format(cambio,       "0.00") & "," & _
        Chr(34) & "items"    & Chr(34) & ":" & sItems & _
    "}"

    ' ── 3. Escribir JSON al archivo temporal ──
    Dim iFile As Integer
    iFile = FreeFile()
    Open rutaJSON For Output As #iFile
        Print #iFile, sJSON
    Close #iFile

    ' ── 4. Invocar Python de forma SÍNCRONA ──
    '    Shell en LibreOffice Basic: Shell(pathname, windowstyle, param, bSync)
    Shell "/usr/bin/python3", 1, rutaScript & " " & rutaJSON, True

    Exit Sub

ErrorSQL:
    MsgBox "Error al registrar en SQLite: " & Err & " - " & Error, 48, "TPV"

End Sub

