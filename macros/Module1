' -----------------------------------------------------------------------------
' HELPER: Devuelve la ruta de la carpeta donde vive el .ods
' -----------------------------------------------------------------------------
Function ObtenerRutaCarpeta() As String
    Dim sURL As String
    sURL = ThisComponent.getURL()           ' file:///home/user/TPV/tpv.ods
    ' Convertir de URL a ruta del sistema operativo
    Dim sPath As String
    sPath = ConvertFromURL(sURL)            ' /home/user/TPV/tpv.ods
    ' Quitar el nombre del archivo — quedarse con la carpeta
    Dim pos As Integer
    pos = 0
    Dim i As Integer
    For i = Len(sPath) To 1 Step -1
        If Mid(sPath, i, 1) = "/" Then
            pos = i
            Exit For
        End If
    Next i
    ObtenerRutaCarpeta = Left(sPath, pos)   ' /home/user/TPV/
End Function

' -----------------------------------------------------------------------------
' HELPER: Carga el catálogo desde catalogo.txt
' Retorna un array de productos
' -----------------------------------------------------------------------------
Function CargarCatalogoDesdeTXT(rutaArchivo As String) As Variant
    On Error GoTo ErrorCatalogo

    Dim aProductos() As String
    Dim iFile As Integer
    Dim sLinea As String
    Dim nombre As String
    Dim precio As Double
    Dim tienePrecio As Boolean
    Dim codigo As String
    Dim nProductos As Integer

    nProductos = -1
    iFile = FreeFile()
    Open rutaArchivo For Input As #iFile
        Do While Not EOF(iFile)
            Line Input #iFile, sLinea
            ParsearLineaCatalogo sLinea, nombre, precio, tienePrecio, codigo
            If Len(Trim(nombre)) > 0 Then
                nProductos = nProductos + 1
                If nProductos = 0 Then
                    ReDim aProductos(0)
                Else
                    ReDim Preserve aProductos(nProductos)
                End If
                aProductos(nProductos) = nombre
            End If
        Loop
    Close #iFile

    If nProductos < 0 Then
        Dim aVacio() As String
        CargarCatalogoDesdeTXT = aVacio
        Exit Function
    End If
    
    CargarCatalogoDesdeTXT = aProductos
    Exit Function
    
ErrorCatalogo:
    On Error Resume Next
    Close #iFile
    MsgBox "Error al cargar catálogo: " & Err & " - " & Error, 48, "TPV"
    Dim aError() As String
    CargarCatalogoDesdeTXT = aError
End Function

Function EsNumeroTexto(valor As String) As Boolean
    Dim limpio As String
    Dim i As Integer
    Dim c As String

    limpio = Trim(valor)
    If limpio = "" Then Exit Function

    For i = 1 To Len(limpio)
        c = Mid(limpio, i, 1)
        If Not ((c >= "0" And c <= "9") Or c = "." Or c = ",") Then
            Exit Function
        End If
    Next i

    EsNumeroTexto = True
End Function

Function EsCodigoTexto(valor As String) As Boolean
    Dim limpio As String
    Dim i As Integer
    Dim c As String
    Dim tieneLetraONumero As Boolean

    limpio = Trim(valor)
    If limpio = "" Then Exit Function

    If InStr(limpio, " ") > 0 Then Exit Function

    tieneLetraONumero = False
    For i = 1 To Len(limpio)
        c = Mid(limpio, i, 1)
        If ((c >= "A" And c <= "Z") Or (c >= "a" And c <= "z") Or (c >= "0" And c <= "9") Or c = "-" Or c = "_") Then
            tieneLetraONumero = True
        Else
            Exit Function
        End If
    Next i

    If Not tieneLetraONumero Then Exit Function

    If InStr(limpio, "0") > 0 Or InStr(limpio, "1") > 0 Or InStr(limpio, "2") > 0 Or InStr(limpio, "3") > 0 Or InStr(limpio, "4") > 0 Or InStr(limpio, "5") > 0 Or InStr(limpio, "6") > 0 Or InStr(limpio, "7") > 0 Or InStr(limpio, "8") > 0 Or InStr(limpio, "9") > 0 Then
        EsCodigoTexto = True
        Exit Function
    End If

    If UCase(limpio) = limpio And Len(limpio) <= 8 Then
        EsCodigoTexto = True
        Exit Function
    End If

End Function

Function NormalizarCodigoComparacion(codigo As String) As String

    Dim limpio As String
    Dim i As Integer
    Dim soloDigitos As Boolean
    Dim partes() As String
    Dim reconstruido As String

    limpio = UCase(Trim(codigo))
    If limpio = "" Then
        NormalizarCodigoComparacion = ""
        Exit Function
    End If

    ' Colapsar espacios repetidos para que "A  B" y "A B" comparen igual.
    partes = Split(limpio, " ")
    reconstruido = ""
    For i = 0 To UBound(partes)
        If Trim(partes(i)) <> "" Then
            If reconstruido = "" Then
                reconstruido = Trim(partes(i))
            Else
                reconstruido = reconstruido & " " & Trim(partes(i))
            End If
        End If
    Next i

    limpio = reconstruido

    soloDigitos = True
    For i = 1 To Len(limpio)
        If Mid(limpio, i, 1) < "0" Or Mid(limpio, i, 1) > "9" Then
            soloDigitos = False
            Exit For
        End If
    Next i

    If soloDigitos Then
        Do While Len(limpio) > 1 And Left(limpio, 1) = "0"
            limpio = Mid(limpio, 2)
        Loop
    End If

    NormalizarCodigoComparacion = limpio

End Function

Function UnirPartesArray(partes() As String, inicio As Integer, fin As Integer) As String
    Dim resultado As String
    Dim i As Integer

    resultado = ""

    If fin < inicio Then
        UnirPartesArray = ""
        Exit Function
    End If

    For i = inicio To fin
        If Trim(partes(i)) <> "" Then
            If resultado = "" Then
                resultado = partes(i)
            Else
                resultado = resultado & " " & partes(i)
            End If
        End If
    Next i

    UnirPartesArray = resultado
End Function

Sub ParsearLineaCatalogo(linea As String, ByRef nombre As String, ByRef precio As Double, ByRef tienePrecio As Boolean, ByRef codigo As String)

    Dim partes() As String
    Dim indicePrecio As Integer
    Dim i As Integer
    Dim esReservada As Boolean

    nombre = ""
    precio = 0
    tienePrecio = False
    codigo = ""

    linea = Trim(linea)
    If linea = "" Then Exit Sub

    ' Quitar marcador de código reservado "-r" si existe al final
    esReservada = (UCase(Right(linea, 2)) = "-R")
    If esReservada Then
        ' Si termina en " -r" quitar los 3 últimos caracteres (espacio + -r)
        If Len(linea) >= 3 And Mid(linea, Len(linea) - 2, 1) = " " Then
            linea = Left(linea, Len(linea) - 3)
            linea = Trim(linea)
        Else
            ' Si no hay espacio, quitar sólo los dos caracteres finales
            linea = Left(linea, Len(linea) - 2)
            linea = Trim(linea)
        End If
    End If

    partes = Split(linea, " ")
    If UBound(partes) < 0 Then Exit Sub

    nombre = linea

    If esReservada Then
        indicePrecio = -1
        For i = 0 To UBound(partes) - 1
            If EsNumeroTexto(partes(i)) Then
                indicePrecio = i
                Exit For
            End If
        Next i

        If indicePrecio > 0 And indicePrecio < UBound(partes) Then
            nombre = UnirPartesArray(partes, 0, indicePrecio - 1)
            precio = CDbl(Replace(partes(indicePrecio), ",", "."))
            tienePrecio = (precio > 0)
            codigo = UnirPartesArray(partes, indicePrecio + 1, UBound(partes))
            If Trim(codigo) <> "" Then Exit Sub
        End If
    End If

    If UBound(partes) >= 1 Then
        If UBound(partes) >= 2 And EsNumeroTexto(partes(UBound(partes) - 1)) And (Not EsNumeroTexto(partes(UBound(partes))) Or EsCodigoTexto(partes(UBound(partes)))) Then
            nombre = UnirPartesArray(partes, 0, UBound(partes) - 2)
            precio = CDbl(Replace(partes(UBound(partes) - 1), ",", "."))
            tienePrecio = (precio > 0)
            codigo = partes(UBound(partes))
        ElseIf EsNumeroTexto(partes(UBound(partes))) Then
            nombre = UnirPartesArray(partes, 0, UBound(partes) - 1)
            precio = CDbl(Replace(partes(UBound(partes)), ",", "."))
            tienePrecio = (precio > 0)
        ElseIf EsCodigoTexto(partes(UBound(partes))) Then
            nombre = UnirPartesArray(partes, 0, UBound(partes) - 1)
            codigo = partes(UBound(partes))
        End If
    ElseIf EsNumeroTexto(partes(0)) Then
        nombre = linea
        precio = CDbl(Replace(partes(0), ",", "."))
        tienePrecio = (precio > 0)
    End If

    If Trim(nombre) = "" Then nombre = linea

End Sub

Sub BuscarProductoPorCodigoEnTXT(rutaArchivo As String, codigoBuscado As String, ByRef nombre As String, ByRef precio As Double, ByRef encontrado As Boolean)

    On Error GoTo ErrorBusqueda

    Dim iFile As Integer
    Dim sLinea As String
    Dim nombreLinea As String
    Dim precioLinea As Double
    Dim tienePrecio As Boolean
    Dim codigoLinea As String
    Dim codigoNormalizado As String

    nombre = ""
    precio = 0
    encontrado = False

    codigoNormalizado = NormalizarCodigoComparacion(codigoBuscado)
    If codigoNormalizado = "" Then Exit Sub

    iFile = FreeFile()
    Open rutaArchivo For Input As #iFile
    Do While Not EOF(iFile)
        Line Input #iFile, sLinea
        ParsearLineaCatalogo sLinea, nombreLinea, precioLinea, tienePrecio, codigoLinea
        If NormalizarCodigoComparacion(codigoLinea) = codigoNormalizado Then
            nombre = nombreLinea
            precio = precioLinea
            encontrado = True
            Exit Do
        End If
    Loop
    Close #iFile
    Exit Sub

ErrorBusqueda:
    On Error Resume Next
    Close #iFile
    MsgBox "Error al buscar código en catálogo: " & Err & " - " & Error, 48, "TPV"

End Sub

' Busca códigos marcados como reservados (líneas que terminan en "-r")
Sub BuscarCodigoReservadoEnTXT(rutaArchivo As String, codigoBuscado As String, ByRef nombre As String, ByRef precio As Double, ByRef encontrado As Boolean)

    On Error GoTo ErrorBusquedaRes

    Dim iFile As Integer
    Dim sLineaRaw As String
    Dim sLinea As String
    Dim nombreLinea As String
    Dim precioLinea As Double
    Dim tienePrecio As Boolean
    Dim codigoLinea As String

    nombre = ""
    precio = 0
    encontrado = False

    codigoBuscado = NormalizarCodigoComparacion(codigoBuscado)
    If codigoBuscado = "" Then Exit Sub

    iFile = FreeFile()
    Open rutaArchivo For Input As #iFile
    Do While Not EOF(iFile)
        Line Input #iFile, sLineaRaw
        sLinea = Trim(sLineaRaw)
        If UCase(Right(sLinea, 2)) = "-R" Then
            ' Quitar el marcador "-r" antes de parsear
            If Len(sLinea) >= 3 And Mid(sLinea, Len(sLinea) - 2, 1) = " " Then
                sLinea = Left(sLinea, Len(sLinea) - 3)
            Else
                sLinea = Left(sLinea, Len(sLinea) - 2)
            End If
            sLinea = Trim(sLinea)

            ParsearLineaCatalogo sLinea, nombreLinea, precioLinea, tienePrecio, codigoLinea
            If NormalizarCodigoComparacion(codigoLinea) = codigoBuscado Then
                nombre = nombreLinea
                precio = precioLinea
                encontrado = True
                Exit Do
            End If
        End If
    Loop
    Close #iFile
    Exit Sub

ErrorBusquedaRes:
    On Error Resume Next
    Close #iFile
    MsgBox "Error al buscar código reservado en catálogo: " & Err & " - " & Error, 48, "TPV"

End Sub

' -----------------------------------------------------------------------------
' HELPER: Registra una venta completa en SQLite invocando db_ventas.py
' Estrategia: escribe el JSON a /tmp/tpv_venta.json y Python lo lee desde ahí,
' eliminando por completo el problema de escapado de comillas en Shell.
' -----------------------------------------------------------------------------
Sub RegistrarVentaEnSQLite( _
    oSheetTPV As Object, _
    filaTotal As Integer, _
    totalTicket As Double, _
    montoCliente As Double, _
    cambio As Double, _
    tActual As Date _
)
    On Error GoTo ErrorSQL

    ' ── 1. Rutas ──
    Dim carpeta As String
    carpeta = ObtenerRutaCarpeta()

    Dim rutaScript As String
    rutaScript = carpeta & "db_ventas.py"

    Dim rutaDB As String
    rutaDB = carpeta & "ventas.db"

    Dim rutaJSON As String
    rutaJSON = "/tmp/tpv_venta.json"

    ' ── 2. Construir JSON ──
    Dim sFecha As String
    Dim sHora  As String
    sFecha = Format(tActual, "YYYY-MM-DD")
    sHora  = Format(tActual, "HH:MM:SS")

    Dim sItems As String
    sItems = "["
    Dim i As Integer
    Dim primero As Boolean
    primero = True

    For i = FILA_PRODUCTOS_INICIO To filaTotal - 1
        Dim prod As String
        prod = oSheetTPV.getCellByPosition(1, i).String
        If prod <> "" Then
            Dim precio   As Double
            Dim cantidad As Integer
            Dim subtotal As Double
            precio   = oSheetTPV.getCellByPosition(2, i).Value
            cantidad = CInt(oSheetTPV.getCellByPosition(3, i).Value)
            subtotal = oSheetTPV.getCellByPosition(4, i).Value

            ' Escapar comillas dobles dentro del nombre
            Dim prodEsc As String
            prodEsc = Join(Split(prod, Chr(34)), "\" & Chr(34))

            If Not primero Then sItems = sItems & ","
            sItems = sItems & "{" & _
                Chr(34) & "producto" & Chr(34) & ":" & Chr(34) & prodEsc & Chr(34) & "," & _
                Chr(34) & "precio"   & Chr(34) & ":" & Format(precio,   "0.00") & "," & _
                Chr(34) & "cantidad" & Chr(34) & ":" & cantidad & "," & _
                Chr(34) & "subtotal" & Chr(34) & ":" & Format(subtotal, "0.00") & _
            "}"
            primero = False
        End If
    Next i
    sItems = sItems & "]"

    Dim sJSON As String
    sJSON = "{" & _
        Chr(34) & "db_path"  & Chr(34) & ":" & Chr(34) & rutaDB       & Chr(34) & "," & _
        Chr(34) & "fecha"    & Chr(34) & ":" & Chr(34) & sFecha        & Chr(34) & "," & _
        Chr(34) & "hora"     & Chr(34) & ":" & Chr(34) & sHora         & Chr(34) & "," & _
        Chr(34) & "total"    & Chr(34) & ":" & Format(totalTicket,  "0.00") & "," & _
        Chr(34) & "recibido" & Chr(34) & ":" & Format(montoCliente, "0.00") & "," & _
        Chr(34) & "cambio"   & Chr(34) & ":" & Format(cambio,       "0.00") & "," & _
        Chr(34) & "items"    & Chr(34) & ":" & sItems & _
    "}"

    ' ── 3. Escribir JSON al archivo temporal ──
    Dim iFile As Integer
    iFile = FreeFile()
    Open rutaJSON For Output As #iFile
        Print #iFile, sJSON
    Close #iFile

    ' ── 4. Invocar Python de forma SÍNCRONA ──
    '    Shell en LibreOffice Basic: Shell(pathname, windowstyle, param, bSync)
    Shell "/usr/bin/python3", 1, rutaScript & " " & rutaJSON, True

    Exit Sub

ErrorSQL:
    MsgBox "Error al registrar en SQLite: " & Err & " - " & Error, 48, "TPV"

End Sub

