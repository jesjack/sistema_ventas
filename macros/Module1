' -----------------------------------------------------------------------------
' 13. CAPITALIZAR
' -----------------------------------------------------------------------------
Function CapitalizarTexto(ByVal texto As String) As String

    Dim palabras() As String
    Dim i As Integer

    texto    = LCase(Trim(texto))
    palabras = Split(texto, " ")

    For i = 0 To UBound(palabras)
        If Len(palabras(i)) > 0 Then
            palabras(i) = UCase(Left(palabras(i),1)) & Mid(palabras(i),2)
        End If
    Next i

    CapitalizarTexto = Join(palabras, " ")

End Function

' -----------------------------------------------------------------------------
' RESUMEN DEL DÍA — pinta H9:K(n) con ventas de hoy desde SQLite vía CSV
' -----------------------------------------------------------------------------
Sub ActualizarResumenDia()

    On Error GoTo ErrorResumen

    Dim carpeta As String
    carpeta = ObtenerRutaCarpeta()

    Dim rutaScript As String
    rutaScript = carpeta & "leer_ventas_hoy.py"

    Dim rutaDB As String
    rutaDB = carpeta & "ventas.db"

    Dim rutaCSV As String
    rutaCSV = "/tmp/tpv_hoy.csv"

    ' ── 1. Llamar Python síncrono para generar el CSV ──
    Shell "/usr/bin/python3", 1, rutaScript & " " & rutaDB & " " & rutaCSV, True

    ' ── 2. Verificar que el CSV existe ──
    If Dir(rutaCSV) = "" Then Exit Sub

    ' ── 3. Leer CSV y pintar la hoja ──
    Dim oDoc   As Object
    Dim oSheet As Object
    oDoc   = ThisComponent
    oSheet = oDoc.Sheets.getByName("TPV")

    oSheet.unprotect("")

    ' Limpiar zona G9:J200 (encabezados + datos anteriores)
    oSheet.getCellRangeByName("G9:J200").clearContents(1023)
    oSheet.getCellRangeByName("G9:J200").CellBackColor = -1

    ' ── Encabezados fila 10 (índice base 0 = fila 9) ──
    Dim colH As Integer : colH = 6   ' G
    Dim colI As Integer : colI = 7   ' H
    Dim colJ As Integer : colJ = 8   ' I
    Dim colK As Integer : colK = 9   ' J

    Dim encHdrs(3) As String
    encHdrs(0) = "PRODUCTO"
    encHdrs(1) = "CANT."
    encHdrs(2) = "PRECIO"
    encHdrs(3) = "SUBTOTAL"

    Dim hdrCols(3) As Integer
    hdrCols(0) = colH : hdrCols(1) = colI
    hdrCols(2) = colJ : hdrCols(3) = colK

    Dim h As Integer
    For h = 0 To 3
        Dim oHdr As Object
        oHdr = oSheet.getCellByPosition(hdrCols(h), 9)  ' fila 10 = índice 9
        oHdr.String = encHdrs(h)
        oHdr.CharColor   = RGB(255, 255, 255)
        oHdr.CharWeight  = com.sun.star.awt.FontWeight.BOLD
        oHdr.CellBackColor = RGB(44, 62, 80)
        oHdr.HoriJustify = com.sun.star.table.CellHoriJustify.CENTER
    Next h

    ' ── Leer CSV línea a línea ──
    Dim iFile  As Integer
    Dim sLinea As String
    Dim filaActual As Integer
    filaActual = 10  ' índice base 0 → fila 11 en pantalla (primera de datos)

    Dim totalDia As Double
    totalDia = 0

    iFile = FreeFile()
    Open rutaCSV For Input As #iFile

    Do While Not EOF(iFile)
        Line Input #iFile, sLinea
        sLinea = Trim(sLinea)
        If sLinea = "" Then GoTo SiguienteLinea

        ' Formato CSV: producto,cantidad,precio,subtotal
        Dim campos() As String
        campos = Split(sLinea, ",")
        If UBound(campos) < 3 Then GoTo SiguienteLinea

        Dim sProd     As String
        Dim nCant     As Double
        Dim nPrecio   As Double
        Dim nSubtotal As Double

        sProd     = campos(0)
        nCant     = CDbl(campos(1))
        nPrecio   = CDbl(campos(2))
        nSubtotal = CDbl(campos(3))

        totalDia = totalDia + nSubtotal

        ' Color alterno de filas
        Dim bgColor As Long
        If (filaActual Mod 2) = 0 Then
            bgColor = RGB(236, 240, 241)
        Else
            bgColor = RGB(255, 255, 255)
        End If

        Dim oC As Object

        oC = oSheet.getCellByPosition(colH, filaActual)
        oC.String = sProd
        oC.CellBackColor = bgColor
        oC.CharColor = RGB(44, 62, 80)

        oC = oSheet.getCellByPosition(colI, filaActual)
        oC.Value = nCant
        oC.CellBackColor = bgColor
        oC.CharColor = RGB(44, 62, 80)
        oC.HoriJustify = com.sun.star.table.CellHoriJustify.CENTER

        oC = oSheet.getCellByPosition(colJ, filaActual)
        oC.Value = nPrecio
        oC.CellBackColor = bgColor
        oC.CharColor = RGB(44, 62, 80)

        oC = oSheet.getCellByPosition(colK, filaActual)
        oC.Value = nSubtotal
        oC.CellBackColor = bgColor
        oC.CharColor = RGB(44, 62, 80)

        filaActual = filaActual + 1

        SiguienteLinea:
    Loop

    Close #iFile

    ' ── Fila de TOTAL DEL DÍA ──
    If filaActual > 10 Then
        Dim oTL As Object
        Dim oTV As Object

        oTL = oSheet.getCellByPosition(colJ, filaActual)
        oTL.String = "TOTAL DÍA:"
        oTL.CharColor  = RGB(255, 255, 255)
        oTL.CharWeight = com.sun.star.awt.FontWeight.BOLD
        oTL.CellBackColor = RGB(192, 57, 43)
        oTL.HoriJustify = com.sun.star.table.CellHoriJustify.RIGHT

        oTV = oSheet.getCellByPosition(colK, filaActual)
        oTV.Value = totalDia
        oTV.CharColor  = RGB(255, 255, 255)
        oTV.CharWeight = com.sun.star.awt.FontWeight.BOLD
        oTV.CellBackColor = RGB(192, 57, 43)
    End If

    ' ── Título sobre la tabla (fila 9 = índice 8) ──
    oSheet.getCellRangeByName("G9:J9").merge(True)
    Dim oTitulo As Object
    oTitulo = oSheet.getCellByPosition(colH, 8)
    oTitulo.String = "VENTAS DE HOY"
    oTitulo.CharColor   = RGB(255, 255, 255)
    oTitulo.CharWeight  = com.sun.star.awt.FontWeight.BOLD
    oTitulo.CellBackColor = RGB(22, 160, 133)
    oTitulo.HoriJustify = com.sun.star.table.CellHoriJustify.CENTER

    ' ── Borrar CSV temporal ──
    Kill rutaCSV

    oSheet.protect("")
    Exit Sub

ErrorResumen:
    On Error Resume Next
    oSheet.protect("")

End Sub

