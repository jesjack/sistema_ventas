Function Key_keyReleased(oEvent) As Boolean

    On Error Resume Next

    Dim keyCode As Integer
    keyCode = oEvent.KeyCode
    
    Dim oSheet As Object
    Dim textoEntrada As String
    textoEntrada = ""

    ' TAB → autocompletar si estamos en B3
    If keyCode = 1282 Then
        Dim oSel As Object
        oSel = ThisComponent.CurrentSelection
        If oSel.supportsService("com.sun.star.table.Cell") Then
            If oSel.CellAddress.Row = 2 And oSel.CellAddress.Column = 1 Then
                AutocompletarB3
                Key_keyReleased = True
                Exit Function
            End If
        End If
    End If

    If keyCode = 1280 Then
        oSheet = ThisComponent.Sheets.getByName("TPV")
        textoEntrada = LCase(Trim(ObtenerTextoEntradaTPV(oSheet)))

        If textoEntrada = "cobrar" Then
            oSheet.getCellRangeByName("B3:D3").clearContents(1023)
            FinalizarVentaEImprimir
            Key_keyReleased = True
            Exit Function
        End If

        If textoEntrada = "limpiar" Then
            LimpiarTicket
            Key_keyReleased = True
            Exit Function
        End If

        AgregarProducto
        Key_keyReleased = True
        Exit Function
    End If

    If keyCode = 764 Then
        FinalizarVentaEImprimir
        Key_keyReleased = True
        Exit Function
    End If

    Key_keyReleased = False

End Function

