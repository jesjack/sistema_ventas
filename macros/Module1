            oCeldaPrecio = oSheet.getCellByPosition(12, filaCatalogo)

            oCeldaNombre.String = nombreCatalogo
            oCeldaNombre.CharColor = RGB(44, 62, 80)
            If (filaCatalogo Mod 2) = 0 Then
                oCeldaNombre.CellBackColor = RGB(243, 246, 248)
                oCeldaPrecio.CellBackColor = RGB(243, 246, 248)
            Else
                oCeldaNombre.CellBackColor = RGB(255, 255, 255)
                oCeldaPrecio.CellBackColor = RGB(255, 255, 255)
            End If

            oCeldaNombre.CharHeight = 9
            oCeldaPrecio.CharHeight = 9
            oCeldaPrecio.HoriJustify = com.sun.star.table.CellHoriJustify.RIGHT

            If tienePrecioCatalogo Then
                oCeldaPrecio.Value = precioCatalogo
            Else
                oCeldaPrecio.clearContents(1023)
            End If

            filaCatalogo = filaCatalogo + 1
        End If
    Loop
    Close #iFileCatalogo

    oSheet.getCellByPosition(11, 1).CellBackColor = RGB(27, 79, 114)
    oSheet.getCellByPosition(11, 1).CharColor = RGB(255, 255, 255)
    oSheet.getCellByPosition(11, 1).CharWeight = com.sun.star.awt.FontWeight.BOLD
